# Kopiere diese Datei nach .env  (cp .env.example .env) und passe sie an.

# Pfad zur SQLite-Datenbank. Auf Render: auf die Persistent Disk zeigen lassen,
# z.B. /var/data/animem.db
ANIMEM_DB_PATH=./data/animem.db

# Ordner für hochgeladene Bilder (Avatare, Banner, Poster).
# Auf Render: z.B. /var/data/uploads
ANIMEM_STORAGE_DIR=./data/uploads

# Owner-Identität: Nur dieses Konto darf /owner betreten (Rolle OWNER).
OWNER_EMAIL=
OWNER_USERNAME=
# NUR für Test-Server ohne Shell: erstes Konto mit OWNER_EMAIL wird automatisch Owner (1 = an).
OWNER_AUTO_PROMOTE=0

# Auf 1 setzen, wenn die App hinter einem Reverse-Proxy läuft (Render, nginx):
# dann wird die echte Client-IP aus X-Forwarded-For gelesen.
TRUST_PROXY=0

# Port/Host für "python app.py"
PORT=5000
HOST=0.0.0.0

# Automatischer Link-Check der Streams alle X Stunden (0 = aus). Verbraucht etwas Datenvolumen/Strom.
LINKCHECK_INTERVAL_HOURS=24
