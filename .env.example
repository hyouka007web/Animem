# Public PocketBase endpoint used by the browser and Next.js server.
# Use HTTPS in production.
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Server-only PocketBase admin credentials. NEVER commit real values.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Comma-separated HTTPS image hosts used by next/image.
# Example: cdn.example.com,images.example.com
ANIMEM_IMAGE_HOSTS=
