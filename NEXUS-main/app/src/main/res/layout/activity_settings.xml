<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <LinearLayout
        android:id="@+id/settingsTopBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/topbar_height"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/settingsBackButton"
            android:layout_width="@dimen/list_row_height"
            android:layout_height="@dimen/list_row_height"
            android:layout_marginStart="-8dp"
            android:background="@drawable/ripple_accent_circle"
            android:contentDescription="Zurück"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/menu_settings"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/type_display_m"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/settingsTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suchmaschine"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/type_caption"
                android:layout_marginBottom="@dimen/space_8" />

            <RadioGroup
                android:id="@+id/searchEngineGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_24">

                <RadioButton
                    android:id="@+id/engineDuckDuckGo"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/list_row_height"
                    android:text="DuckDuckGo"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent_primary" />

                <RadioButton
                    android:id="@+id/engineGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/list_row_height"
                    android:text="Google"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent_primary" />

                <RadioButton
                    android:id="@+id/engineBing"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/list_row_height"
                    android:text="Bing"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent_primary" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_hairline"
                android:layout_marginBottom="@dimen/space_16" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Adblocker aktiv"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/type_body" />

                <Switch
                    android:id="@+id/adBlockSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/accent_primary"
                    android:trackTint="@color/bg_surface_raised" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:text="NEXUS Browser · 0.2.0-alpha"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/type_caption" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
