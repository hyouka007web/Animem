<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- design.md: "Dark-Mode-only" -> forceDarkAllowed false, wir setzen die Farben explizit -->
    <style name="Theme.TUFBlade" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorSecondary">@color/accent_success</item>
        <item name="colorError">@color/accent_danger</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
    </style>

    <!-- Fokus-Ring gemäß design.md Abschnitt 8: 2px accent_primary, 2dp Abstand -->
    <style name="FocusRing">
        <item name="android:outlineAmbientShadowColor">@android:color/transparent</item>
    </style>
</resources>
